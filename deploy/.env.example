# ─────────────────────────────────────────────────────────────
# Nomos Council — Environment Variables
#
# Copy this file to .env and fill in your API keys:
#   cp deploy/.env.example deploy/.env
# ─────────────────────────────────────────────────────────────

# Required by the shipped configs/council.yaml
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: Additional backends (uncomment/switch member backends in council.yaml too)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Optional: Mount a different council profile into the local MCP container.
# Path is interpreted by docker compose relative to the compose file's
# directory (i.e. relative to deploy/), NOT relative to your shell CWD —
# so the example below resolves to <repo_root>/configs/council.yaml. If
# the resolved path doesn't exist on the host, docker silently mounts an
# empty directory at /app/configs/council.yaml inside the container,
# masking the image's baked-in copy and breaking NAT startup; pass an
# absolute path if you're unsure. Evaluation harnesses should pass an
# absolute path when selecting alternate council profiles; the relative
# example below is for manual compose runs.
# COUNCIL_CONFIG_FILE=../configs/council.yaml

# Redis authentication (change this in production!)
REDIS_PASSWORD=nomos-dev
# Compose Redis topology defaults to Sentinel. Set "standalone" only for local
# single-Redis runs that explicitly do not need failover.
# COMPOSE_REDIS_TOPOLOGY=standalone
# REDIS_SENTINEL_SERVICE_NAME=nomos-master
# HMAC key for Redis account-critical state. scripts/deploy_stack.sh generates
# this automatically when omitted.
COUNCIL_REDIS_ACCOUNT_INTEGRITY_KEY=change-me-account-integrity

# Required for mutating dynamic-council MCP tools.
# scripts/deploy_stack.sh generates this automatically when omitted.
COUNCIL_MANAGEMENT_TOKEN=change-me-council-management

# OPA intent filtering is enabled by default. Leave this true for alpha access.
COUNCIL_OPA_ENABLED=true
# COUNCIL_OPA_URL=http://opa:8181
# COUNCIL_OPA_DECISION_PATH=/v1/data/nomos/intent/decision
# COUNCIL_OPA_POLICY_ID=strict-shell
# GIT_WORKFLOW_COUNCIL_OPA_POLICY_ID=git-workflow-local
# COUNCIL_OPA_TIMEOUT_MS=500
# COUNCIL_OPA_FAIL_CLOSED=true
# OPA_IMAGE=openpolicyagent/opa:latest
# OPA_POLICY_DIR=../policies
# OPA_PORT=8181

# Optional: Override the externally visible MCP/monitor port.
# The council container itself is internal-only in the main compose stack.
# MONITOR_PORT=9901

# IP address advertised by deploy_stack.sh and shown in generated signup
# credentials. Hostnames are intentionally avoided because they often do not
# resolve for every plugin user. Set this explicitly on remote machines when
# auto-detection is not the address your users should reach.
# NOMOS_PUBLIC_HOST=203.0.113.10

# Optional: host path mounted into the dev executor profile.
# A relative path is interpreted relative to deploy/docker-compose.yml.
# DEV_REPO_PATH=../my-project

# Optional: Override externally visible service bind addresses.
# REDIS_BIND_ADDR=0.0.0.0
# OPA_BIND_ADDR=0.0.0.0
# AGENT_SIGNUP_PORT=9905
# AGENT_SIGNUP_BIND_ADDR=0.0.0.0
# COUNCIL_GRPC_BIND_ADDR=0.0.0.0
# NOMOS_SIGNUP_COUNCIL_ID=council-prod
# NOMOS_SIGNUP_ALLOWED_COUNCILS=council-prod
# NOMOS_SIGNUP_DEFAULT_ROLE=developer
# NOMOS_SIGNUP_ALLOWED_ROLES=readonly,developer
NOMOS_SIGNUP_ADMIN_USER=admin
NOMOS_SIGNUP_ADMIN_PASSWORD=replace-with-signup-admin-password

# Basic auth for the browser monitor board at /, /static, and /api.
# MCP traffic on /mcp and health probes stay unauthenticated.
MONITOR_DASHBOARD_USER=admin
MONITOR_DASHBOARD_PASSWORD=replace-with-monitor-password
