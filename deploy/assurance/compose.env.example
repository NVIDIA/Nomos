# Copy outside version control, fill all non-optional blanks, and chmod 600.
ASSURANCE_IMAGE=nomos-assurance:local
# Absolute directory with trusted-keys.json; add ethos.json and ETHOS files for ETHOS.
ASSURANCE_CONFIG_DIR=
ASSURANCE_COUNCIL_ID=
ASSURANCE_CHAIN_ID=
ASSURANCE_SOURCE_TOKEN=
ASSURANCE_DASHBOARD_USER=
ASSURANCE_DASHBOARD_PASSWORD=
ASSURANCE_API_READ_TOKEN=
ASSURANCE_POLL_SECONDS=2
ASSURANCE_ANALYSIS_SECONDS=300
# ETHOS runs daily; use 172800 for every other day or 604800 for weekly.
ASSURANCE_ETHOS_ANALYSIS_SECONDS=86400
ASSURANCE_ETHOS_WINDOW_SIZE=10000
ASSURANCE_PORT=8090
ASSURANCE_BIND_ADDR=127.0.0.1
ASSURANCE_ETHOS_ENABLED=false
ASSURANCE_MODEL=
ASSURANCE_API_BASE=
ASSURANCE_API_KEY=
ASSURANCE_INFERENCE_TIMEOUT=60
ASSURANCE_STREAM_TIMEOUT=120
ASSURANCE_MAX_TOKENS=4096
ASSURANCE_MAX_MODEL_CALLS=20
# Requires an image built with the optional Eval Author export target.
ASSURANCE_EXPORT_ENABLED=false
