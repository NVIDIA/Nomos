+#[test]
+fn chat_several_tools_edited_in_place_keep_their_own_provider_fields() {
+    let codec = OpenAIChatCodec;
+    let original = make_request(json!({
+        "model": "gpt-4.1",
+        "messages": [{"role": "user", "content": "hello"}],
+        "tools": [
+            {"type": "function", "function": {"name": "run_shell", "parameters": {"type": "object", "properties": {"command": {"type": "string"}}}}, "vendor_hint": "A"},
+            {"type": "function", "function": {"name": "read_file", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}}}, "vendor_hint": "B"}
+        ]
+    }));
+    let mut annotated = codec.decode(&original).unwrap();
+    for tool in annotated.tools.as_mut().unwrap() {
+        let ToolDefinition::Function { function, .. } = tool else {
+            panic!("expected portable function tool");
+        };
+        let params = function.parameters.as_mut().unwrap();
+        params["properties"]["intent"] = json!({"type": "object"});
+        params["required"] = json!(["intent"]);
+    }
+
+    let encoded = codec.encode(&annotated, &original).unwrap();
+    let tools = encoded.content["tools"].as_array().unwrap();
+    assert_eq!(tools[0]["vendor_hint"], json!("A"));
+    assert_eq!(tools[1]["vendor_hint"], json!("B"));
+    assert_eq!(tools[0]["function"]["name"], json!("run_shell"));
+    assert_eq!(tools[1]["function"]["name"], json!("read_file"));
+    for tool in tools {
+        assert_eq!(
+            tool["function"]["parameters"]["required"],
+            json!(["intent"])
+        );
+        assert!(tool["function"]["parameters"]["properties"]["intent"].is_object());
+    }
+}
