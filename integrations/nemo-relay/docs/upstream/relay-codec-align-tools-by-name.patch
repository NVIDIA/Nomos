+#[test]
+fn chat_reordered_and_edited_tools_align_by_name() {
+    let codec = OpenAIChatCodec;
+    let original = make_request(json!({
+        "model": "gpt-4.1",
+        "messages": [{"role": "user", "content": "hello"}],
+        "tools": [
+            {"type": "function", "function": {"name": "a", "parameters": {"type": "object"}}, "vendor_hint": "A"},
+            {"type": "function", "function": {"name": "b", "parameters": {"type": "object"}}, "vendor_hint": "B"}
+        ]
+    }));
+    let mut annotated = codec.decode(&original).unwrap();
+    let tools = annotated.tools.as_mut().unwrap();
+    tools.swap(0, 1);
+    for tool in tools.iter_mut() {
+        let ToolDefinition::Function { function, .. } = tool else {
+            panic!("expected function tool")
+        };
+        function.description = Some(format!("edited {}", function.name));
+    }
+    let encoded = codec.encode(&annotated, &original).unwrap();
+    let tools = encoded.content["tools"].as_array().unwrap();
+    assert_eq!(tools[0]["function"]["name"], json!("b"));
+    assert_eq!(tools[0]["vendor_hint"], json!("B"));
+    assert_eq!(tools[1]["function"]["name"], json!("a"));
+    assert_eq!(tools[1]["vendor_hint"], json!("A"));
+    assert_eq!(tools[0]["function"]["description"], json!("edited b"));
+}
