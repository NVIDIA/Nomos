+/// Encode an edited tool list, aligning tools with the original by function name.
+///
+/// `encode_changed_items` aligns array items by value, so it cannot tell which
+/// original item an edited item came from once more than one item has changed,
+/// and refuses. Function tools carry a stable identity, their name, so when every
+/// name is unique on both sides, each edited tool is patched onto the original
+/// entry with the same name and provider-only fields survive. Any tool without a
+/// usable identity (provider-native, or a duplicated name) falls back to the
+/// value-aligned path, which keeps its existing rejection of ambiguous edits.
+fn encode_changed_tools<F>(
+    edited: &[request::ToolDefinition],
+    baseline: &[request::ToolDefinition],
+    original: Option<&[Json]>,
+    mut encode: F,
+) -> Result<Vec<Json>>
+where
+    F: FnMut(&request::ToolDefinition) -> Result<Json>,
+{
+    fn name(tool: &request::ToolDefinition) -> Option<&str> {
+        match tool {
+            request::ToolDefinition::Function { function, .. } => Some(function.name.as_str()),
+            request::ToolDefinition::ProviderNative { .. } => None,
+        }
+    }
+    fn unique_names(
+        tools: &[request::ToolDefinition],
+    ) -> Option<std::collections::HashMap<&str, usize>> {
+        let mut seen = std::collections::HashMap::new();
+        for (index, tool) in tools.iter().enumerate() {
+            if seen.insert(name(tool)?, index).is_some() {
+                return None;
+            }
+        }
+        Some(seen)
+    }
+    let (Some(original), Some(baseline_names), Some(_)) =
+        (original, unique_names(baseline), unique_names(edited))
+    else {
+        return encode_changed_items(edited, baseline, original, encode);
+    };
+    // Use name alignment only when it explains every edited tool; renamed or new tools
+    // take the value-aligned path, which already handles a single in-place change.
+    let every_tool_has_a_named_origin = edited
+        .iter()
+        .all(|tool| name(tool).is_some_and(|n| baseline_names.contains_key(n)));
+    if original.len() != baseline.len() || !every_tool_has_a_named_origin {
+        return encode_changed_items(edited, baseline, Some(original), encode);
+    }
+    edited
+        .iter()
+        .map(|tool| {
+            let index = baseline_names[name(tool).expect("checked above")];
+            if baseline[index] == *tool {
+                return Ok(original[index].clone());
+            }
+            let baseline_value = encode(&baseline[index])?;
+            let edited_value = encode(tool)?;
+            patch_changed_json(&original[index], &baseline_value, &edited_value)
+        })
+        .collect()
+}
